# ============================================================
# Frame Autonomous AI Shopping Agent Environment Configuration
# ============================================================

# ── LLM Configuration ──────────────────────────────────────
# Provider: 'openai-compatible' | 'anthropic' | 'deterministic'
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Frame MCP Configuration ─────────────────────────────────
# Frame API URL (used by MCP stdio server or HTTP client)
FRAME_API_URL=https://frame-backend-868z.onrender.com/v1
# Frame Agent API Key (format: frm_test_... or frm_live_...)
FRAME_AGENT_API_KEY=
# Path to backend MCP entrypoint or 'npx' command
FRAME_MCP_ENTRY=../agentpay/backend/src/mcp/index.ts

# ── Merchant Configuration ──────────────────────────────────
# Default merchant base URL (defaults to local DemoMerchantStore)
MERCHANT_BASE_URL=http://localhost:3002

# ── Agent Server / API Configuration ────────────────────────
PORT=3005
AGENT_ENV=development
