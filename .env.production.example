# ==============================================================================
# Frame — Production Environment Template (.env.production)
# ==============================================================================
# Copy this file to .env.production and fill in your real values.
# NEVER commit real secret values to Git!

# ── Runtime & Networking ─────────────────────────────────
NODE_ENV=production
FRAME_ENV=production
PORT=3001
PORT_HTTP=80
PORT_HTTPS=443
PUBLIC_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# ── Database (PostgreSQL 16+) ────────────────────────────
POSTGRES_USER=frame_admin
POSTGRES_PASSWORD=generate_a_strong_password_here_32_chars
POSTGRES_DB=frame
DATABASE_URL=postgres://frame_admin:generate_a_strong_password_here_32_chars@postgres:5432/frame

# ── Cache & Queue (Redis 7+) ─────────────────────────────
REDIS_URL=redis://redis:6379

# ── Security & Authentication ────────────────────────────
# Generate using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters
API_KEY_SALT=replace_with_a_secure_random_salt_for_api_keys

# ── Payment Gateway (Razorpay Sandbox / Production) ──────
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Frontend Configuration ───────────────────────────────
NEXT_PUBLIC_API_URL=https://your-api-domain.com/v1
