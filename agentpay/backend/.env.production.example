# ==============================================================================
# Frame Backend — Production Environment Template
# ==============================================================================
# Copy this file to .env on your production host or configure these secrets
# in your cloud provider environment settings (Render, Railway, Fly.io, AWS, etc.)

# Database Connection (PostgreSQL 15+ / 16+)
DATABASE_URL=postgres://frame_user:YOUR_STRONG_PASSWORD@your-db-host:5432/frame?sslmode=require

# Cache & Queue Connection (Redis 7+)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@your-redis-host:6379

# Cryptographic Secrets (MINIMUM 32 CHARACTERS, RANDOMLY GENERATED)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
API_KEY_SALT=REPLACE_WITH_STRONG_RANDOM_SALT_MIN_32_CHARS

# Server & Runtime Configuration
PORT=3001
NODE_ENV=production
FRAME_ENV=production

# Public URLs & CORS
PUBLIC_URL=https://api.yourdomain.com
# Comma-separated list of allowed origins (e.g. your frontend domain)
CORS_ORIGIN=https://app.yourdomain.com,https://yourdomain.com

# Payment Provider Configuration (Razorpay Live)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
# Webhook secret configured in your Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
