{
  "name": "frame-backend",
  "version": "1.0.0",
  "description": "Frame — AI Agent Payment Infrastructure Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "mcp": "ts-node -r tsconfig-paths/register src/mcp/index.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "test": "ts-node -r tsconfig-paths/register tests/e2e-acceptance.ts && ts-node -r tsconfig-paths/register tests/providers/razorpay-sandbox.ts && ts-node -r tsconfig-paths/register tests/security-tenant-isolation.ts && ts-node -r tsconfig-paths/register tests/queue-worker-async.ts && ts-node -r tsconfig-paths/register tests/mcp/mcp-server.test.ts && ts-node -r tsconfig-paths/register tests/e2e-agent-checkout.test.ts && ts-node -r tsconfig-paths/register tests/payment-authority/authority.test.ts && ts-node -r tsconfig-paths/register tests/real-payment-rail/rail-capabilities.test.ts",
    "test:acceptance": "ts-node -r tsconfig-paths/register tests/e2e-acceptance.ts",
    "test:provider": "ts-node -r tsconfig-paths/register tests/providers/razorpay-sandbox.ts",
    "test:security": "ts-node -r tsconfig-paths/register tests/security-tenant-isolation.ts",
    "test:worker": "ts-node -r tsconfig-paths/register tests/queue-worker-async.ts",
    "test:audit": "ts-node -r tsconfig-paths/register tests/execution-correctness-audit.ts",
    "test:live-sandbox": "ts-node -r tsconfig-paths/register tests/providers/razorpay-live-sandbox.ts",
    "test:webhook": "ts-node -r tsconfig-paths/register tests/providers/razorpay-webhook-local.ts",
    "test:mcp": "ts-node -r tsconfig-paths/register tests/mcp/mcp-server.test.ts",
    "test:mcp-external": "ts-node -r tsconfig-paths/register tests/mcp/external-agent.test.ts",
    "test:mcp-smoke": "ts-node -r tsconfig-paths/register tests/mcp/mcp-smoke-test.ts",
    "test:agent-checkout": "ts-node -r tsconfig-paths/register tests/e2e-agent-checkout.test.ts",
    "test:payment-authority": "ts-node -r tsconfig-paths/register tests/payment-authority/authority.test.ts",
    "test:payment-rail": "ts-node -r tsconfig-paths/register tests/real-payment-rail/rail-capabilities.test.ts",
    "test:real-agent-payment": "ts-node -r tsconfig-paths/register tests/e2e-real-agent-payment.test.ts",
    "test:sdk-ts": "ts-node -r tsconfig-paths/register tests/sdk/typescript/sdk-integration.test.ts",
    "test:sdk-py": "python3 tests/sdk/python/sdk_integration_test.py",
    "test:e2e-external": "ts-node -r tsconfig-paths/register tests/e2e/external-agent-purchase.test.ts",
    "demo:agent-payment": "ts-node -r tsconfig-paths/register src/demo-merchant/demo-runner.ts",
    "demo:agent-authorized-payment": "ts-node -r tsconfig-paths/register src/demo-merchant/demo-authorized-runner.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.13.0",
    "dayjs": "^1.11.12",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "typescript": "^5.5.3",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
